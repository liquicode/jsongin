{
    "name": "@liquicode/jsongin",
    "version": "0.1.1",
    "description": "A JSON Engine for MongoDB-Style Queries and Data Structure Manipulation",
    "license": "MIT",
    "homepage": "http://jsongin.liquicode.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liquicode/jsongin.git"
    },
    "authors": [
        {
            "name": "Andre' G. Bowlin",
            "email": "agbowlin@gmail.com",
            "homepage": "http://liquicode.com"
        }
    ],
    "main": "src/jsongin.js",
    "types": "./types/jsongin.d.ts",
    "exports": {
        ".": {
            "types": "./types/jsongin.d.ts",
            "import": "./src/jsongin.mjs",
            "require": "./src/jsongin.js",
            "default": "./src/jsongin.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "dist",
        "types",
        "docs/guides",
        "license.md",
        "readme.md",
        "history.md"
    ],
    "scripts": {
        "test": "node build/run-tests.js",
        "parity-test-jsongin": "mocha -u bdd \"test/Parity Tests/jsongin-Tests.js\" --timeout 0 --slow 10 --colors",
        "parity-test-mongodb": "mocha -u bdd \"test/Parity Tests/MongoDB-Tests.js\" --timeout 0 --slow 10 --colors",
        "parity-report": "node build/parity.js",
        "api-coverage": "node build/api-coverage.js",
        "coverage": "node build/coverage.js",
        "scope-check": "node build/scope-check.js",
        "types-check": "node build/types-check.js",
        "check-docs": "node build/docs-check.js",
        "run tests": "npx @liquicode/devops --tasks .\\build\\build.tasks.js run_tests",
        "build docs": "npx @liquicode/devops --tasks .\\build\\build.tasks.js build_docs",
        "run webpack": "npx @liquicode/devops --tasks .\\build\\build.tasks.js run_webpack",
        "publish version": "npx @liquicode/devops --tasks .\\build\\build.tasks.js publish_version",
        "start new version": "npx @liquicode/devops --tasks .\\build\\build.tasks.js start_new_version"
    },
    "keywords": [
        "mongo",
        "mongodb",
        "query",
        "qbe",
        "$eq",
        "$and",
        "object",
        "compare"
    ],
    "devDependencies": {
        "@liquicode/devops": "^0.1.0",
        "@seald-io/nedb": "^4.0.2",
        "babel-polyfill": "6.x",
        "json-criteria": "2.x",
        "mocha": "^10.2.0",
        "mongodb": "4.x",
        "nedb": "^1.8.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    }
}
